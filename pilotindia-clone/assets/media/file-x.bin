				<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svgjs="http://svgjs.dev/svgjs" id="Layer_1" viewBox="0 0 512 512" width="300" height="300"><g width="100%" height="100%" transform="matrix(1,0,0,1,0,0)"><g><g><path d="m322.857 381.418h.444l44.945-45.446h-45.389z" fill="#e09900" fill-opacity="1" data-original-color="#000000ff" stroke="none" stroke-opacity="1"></path><path d="m145.52 381.418h147.337v-75.446h75.624v-175.39h-222.961zm74.596-147.267 20.813 20.814 48.104-48.104 21.213 21.213-69.316 69.316-42.026-42.027z" fill="#e09900" fill-opacity="1" data-original-color="#000000ff" stroke="none" stroke-opacity="1"></path><path d="m30 30h44.973v-30h-74.973v74.973h30z" fill="#e09900" fill-opacity="1" data-original-color="#000000ff" stroke="none" stroke-opacity="1"></path><path d="m437.027 0v30h44.973v44.973h30v-74.973z" fill="#e09900" fill-opacity="1" data-original-color="#000000ff" stroke="none" stroke-opacity="1"></path><path d="m30 437.027h-30v74.973h74.973v-30h-44.973z" fill="#e09900" fill-opacity="1" data-original-color="#000000ff" stroke="none" stroke-opacity="1"></path><path d="m482 482h-44.973v30h74.973v-74.973h-30z" fill="#e09900" fill-opacity="1" data-original-color="#000000ff" stroke="none" stroke-opacity="1"></path></g><path d="m256 0c-68.38 0-132.667 26.629-181.02 74.98-48.351 48.353-74.98 112.64-74.98 181.02s26.629 132.667 74.98 181.02c48.353 48.351 112.64 74.98 181.02 74.98s132.667-26.629 181.02-74.98c48.351-48.353 74.98-112.64 74.98-181.02s-26.629-132.667-74.98-181.02c-48.353-48.351-112.64-74.98-181.02-74.98zm225.538 270.35c-3.422 54.967-26.446 106.171-65.732 145.456-38.569 38.57-88.623 61.476-142.45 65.537v-41.23h-30v41.53c-55.613-3.047-107.47-26.144-147.161-65.836-39.286-39.285-62.311-90.489-65.732-145.456h43.131v-30h-43.052c3.702-54.474 26.677-105.18 65.653-144.155 39.691-39.692 91.548-62.789 147.161-65.836v40.229h30v-39.932c53.827 4.061 103.882 26.967 142.45 65.537 38.976 38.975 61.951 89.681 65.653 144.155h-3