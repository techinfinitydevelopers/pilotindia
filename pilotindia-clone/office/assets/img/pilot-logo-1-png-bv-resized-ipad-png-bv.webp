.pilot-blocks-section {
  width: 40%;
  padding: 0;
  margin: 0 auto;
  overflow: hidden;
  text-align: center;
}
.pilot-blocks-wrap {
  display: flex;
  width: 100%;
  margin: 0;
  padding: 0;
  gap: 0;
  align-items: stretch;
}
.pilot-block {
  flex: 1;
  padding: 26px 10px !important;
  text-align: center !important;
  font-weight: 600 !important;
  font-size: 18px !important;
  letter-spacing: 1px !important;
  line-height: 1.4em !important;
  text-decoration: none !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  margin: 0 !important;
  border: none !important;
  outline: none !important;
  position: static !important;
  transform: none !important;
  box-shadow: none !important;
  transition: color 0.3s ease !important;
  -webkit-transition: color 0.3s ease !important;
}
.pilot-block:hover,
.pilot-block:focus,
.pilot-block:active {
  text-decoration: none !important;
  transform: none !important;
  -webkit-transform: none !important;
  box-shadow: none !important;
  padding: 26px 10px !important;
  margin: 0 !important;
  outline: none !important;
}
.pilot-block.white {
  background: rgba(232, 232, 232, 0.6) !important;
  color: #000000 !important;
}
.pilot-block.black {
  background: rgba(26, 26, 26, 0.8) !important;
  color: #ffffff !important;
}
.pilot-block.white:hover,
.pilot-block.white:focus,
.pilot-block.white:active {
  background: rgba(255,255,255,0.55) !important;
  color: #e09900 !important;
}
.pilot-block.black:hover,
.pilot-block.black:focus,
.pilot-block.black:active {
  background: rgba(0,0,0,0.55) !important;
  color: #e09900 !important;
}
.pilot-block span {
  display: block;
  pointer-events: none;
  font-size: 18px !important;
  font-weight: 600 !important;
  line-height: 1.4em !important;
  letter-spacing: 1px !important;
}
@media (max-width: 768px) {
  .pilot-blocks-section {
    width: 100% !important;
  }
  .pilot-blocks-wrap {
    flex-direction: column !important;
  }
  .pilot-block {
    width: 100% !important;
    padding: 16px 20px !important;
    text-align: left !important;
    justify-content: flex-start !important;
    border-bottom: 1px solid rgba(255,255,255,0.1) !important;
  }
  .pilot-block:hover,
  .pilot-block:focus,
  .pilot-block:active {
    padding: 16px 20px !important;
  }
  .pilot-block.white {
    background: #2c2a2f !important;
    color: #ffffff !important;
  }
  .pilot-block.black {
    background: #363439 !important;
    color: #ffffff !important;
