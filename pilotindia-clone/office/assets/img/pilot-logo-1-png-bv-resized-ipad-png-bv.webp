<style class="bv-critical-css">
.pilot-blocks-section {
  width: 40%;
  padding: 0;
  margin: 0 auto;
  overflow: hidden;
  text-align: center;
}
.pilot-blocks-wrap {
  display: flex;
  width: 100%;
  margin: 0;
  padding: 0;
  gap: 0;
  align-items: stretch;
}
.pilot-block {
  flex: 1;
  padding: 26px 10px !important;
  text-align: center !important;
  font-weight: 600 !important;
  font-size: 18px !important;
  letter-spacing: 1px !important;
  line-height: 1.4em !important;
  text-decoration: none !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  margin: 0 !important;
  border: none !important;
  outline: none !important;
  position: static !important;
  transform: none !important;
  box-shadow: none !important;
  transition: color 0.3s ease !important;
  -webkit-transition: color 0.3s ease !important;
}
.pilot-block.white {
  background: rgba(232, 232, 232, 0.6) !important;
  color: #000000 !important;
}
.pilot-block.black {
  background: rgba(26, 26, 26, 0.8) !important;
  color: #ffffff !important;
}
.pilot-block span {
  display: block;
  pointer-events: none;
  font-size: 18px !important;
  font-weight: 600 !important;
  line-height: 1.4em !important;
  letter-spacing: 1px !important;
}
@media (max-width: 768px) {.pilot-blocks-section {
    width: 100% !important;
  }}@media (max-width: 768px) {.pilot-blocks-wrap {
    flex-direction: column !important;
  }}@media (max-width: 768px) {.pilot-block {
    width: 100% !important;
    padding: 16px 20px !important;
    text-align: left !important;
    justify-content: flex-start !important;
    border-bottom: 1px solid rgba(255,255,255,0.1) !important;
  }}@media (max-width: 768px) {.pilot-block.white {
    background: #2c2a2f !important;
    color: #ffffff !important;
  }}@media (max-width: 768px) {.pilot-block.black {
    background: #363439 !important;
    color: #ffffff !important;
  }}
</style>
<style class="bv-critical-css" bv-identifier="https://pilotofficeproducts.com/wp-includes/css/dist/block-library/style.min.css?ver=6.8.6" id="wp-block-library-css">
@keyframes show-content-image{0%{visibility:hidden}99%{visibility:hidden}to{visibility:visible}}
@keyframes turn-on-visibility{0%{opacity:0}to{opacity:1}}
@keyframes turn-off-visibility{0%{opacity:1;visibility:visible}99%{opacity:0;visibility:visible}to{opacity:0;visibility:hidden}}
@keyframes lightbox-zoom-in{0%{transform:translate(calc((-100vw + var(--wp--lightbox-scrollbar-width))/2 + var(--wp--lightbox-initial-left-position)),calc(-50vh + var(--wp--lightbox-initial-top-position))) scale(var(--wp--lightbox-scale))}to{transform:translate(-50%,-50%) scale(1)}}
@keyframes lightbox-zoom-out{0%{transform:translate(-50%,-50%) scale(1);visibility:visible}99%{visibility:visible}to{transform:translate(calc((-100vw + var(--wp--lightbox-scrollbar-width))/2 + var(--wp--lightbox-initial-left-position)),calc(-50vh + var(--wp--lightbox-initial-top-position))) scale(var(--wp--lightbox-scale));visibility:hidden}}
ol,ul{box-sizing:border-box}
@keyframes overlay-menu__fade-in-animation{0%{opacity:0;transform:translateY(.5em)}to{opacity:1;transform:translateY(0)}}
.editor-styles-wrapper,.entry-content{counter-reset:footnotes}
:root{--wp--preset--font-size--normal:16px;--wp--preset--font-size--huge:42px}
html :where(img[class*=wp-image-]){height:auto;max-width:100%}:where(figure){margin:0 0 1em}

</style>
<style class="bv-critical-css" bv-identifier="et-builder-module-design-deferred-21384-cached-inline-styles" id="et-builder-module-design-deferred-21384-cached-inline-styles">
#top-menu li.current-menu-item>a{color:#e09900!important}#et-top-navigation{font-family:Open Sans,Arial,sans-serif}
#top-menu>li ul li:last-child>a{border:none;padding-bottom:200px}#et-secondary-nav .menu-item-has-children>a:first-child:after,#top-menu .menu-item-has-children>a:first-child:after{display:none!important}.nav li ul{position:absolute;padding:0px 0;margin-top:3px;z-index:9999;width:350px;background:#fff;visibility:hidden;opacity:0;border-top:0px solid #2ea3f200;box-shadow:0 2px 5px rgb(0 0 0 / 10%);-moz-box-shadow:0 2px 5px rgba(0,0,0,.1);-webkit-box-shadow:0 2px 5px rgb(0 0 0 / 10%);-webkit-transform:translateZ(0);text-align:left}
.et_mobile_menu{position:absolute;left:0;padding:5%;background:#fff;width:100%;visibility:visible;opacity:1;display:none;z-index:9999;border-top:0px solid #2ea3f2;box-shadow:0 2px 5px rgb(0 0 0 / 10%);-moz-box-shadow:0 2px 5px rgba(0,0,0,.1);-webkit-box-shadow:0 2px 5px rgb(0 0 0 / 10%)}
#top-menu li li{padding:0 0px;margin:0;border-bottom:1px solid #666666}#top-menu li li a{padding:6px 20px;width:350px}
@media only screen and (max-width:700px){.mobile_menu_bar:before{color:#ce8742!important}.et_header_style_left #et-top-navigation .mobile_menu_bar,.et_header_style_split #et-top-navigation .mobile_menu_bar{padding-bottom:15px}.et_header_style_left #et-top-navigation,.et_header_style_left .et-fixed-header #et-top-navigation{padding-top:15px;display:block}#main-header{position:fixed!important}body{overflow-x:hidden}}#footer-bottom{background-color:#fff;padding:15px 0 5px}
#logo{float:left;margin-right:60px;margin-top:10px}
@media only screen and (min-width:700px){#et-top-navigation{float:left;padding-left:270px!important}}#top-menu li{display:inline-block;font-size:25px;padding-right:10px}
.second-level{display:none}

</style>


